# rosbridge(WebSocket) 환경 변수. VIP3 의 유일한 MORAI 전송 경로다.
# 이 파일은 MORAI UI 설정을 바꾸지 않는다 — UI 에는 같은 값을 손으로 넣어야 한다.
export MORAI_BRIDGE_PORT="${MORAI_BRIDGE_PORT:-9090}"
export MORAI_BRIDGE_BIND="${MORAI_BRIDGE_BIND:-0.0.0.0}"
export ROS_MASTER_URI="http://127.0.0.1:11311"
export ROS_IP="${ROS_IP:-127.0.0.1}"

# MORAI(Windows) 는 항상 Docker 퍼블리시 포트로 붙는다. 추정하지 않는다.
export MORAI_BRIDGE_IP="127.0.0.1"

# rosbridge 처리량 파라미터 (rosbridge_websocket.launch 의 실제 arg 이름).
# 1280x720 JPEG 2대 + 640x480 2대를 base64 JSON 으로 받으면 기본값
# (max_message_size=None / fragment_timeout=600)에서 조각 재조립 지연이 누적된다.
export MORAI_ROSBRIDGE_MAX_MESSAGE_SIZE="${MORAI_ROSBRIDGE_MAX_MESSAGE_SIZE:-100000000}"
export MORAI_ROSBRIDGE_FRAGMENT_TIMEOUT="${MORAI_ROSBRIDGE_FRAGMENT_TIMEOUT:-60}"
export MORAI_ROSBRIDGE_UNREGISTER_TIMEOUT="${MORAI_ROSBRIDGE_UNREGISTER_TIMEOUT:-10}"
