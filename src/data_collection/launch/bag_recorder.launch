<launch>
  <arg name="profile" default="full_raw"/>
  <arg name="scenario" default=""/>
  <arg name="controller" default=""/>
  <arg name="run_id" default=""/>
  <arg name="rosbag_root" default=""/>
  <arg name="map_slug" default="kcity2025"/>
  <arg name="weather" default=""/>
  <arg name="sim_hour" default=""/>
  <arg name="grpc_address" default="127.0.0.1"/>
  <arg name="grpc_port" default="7789"/>
  <arg name="grpc_timeout_sec" default="1.0"/>
  <arg name="grpc_connect_timeout_sec" default="2.0"/>
  <arg name="environment_poll_sec" default="2.0"/>
  <arg name="topic_timeout_sec" default="10.0"/>
  <arg name="parent_raw_run_id" default=""/>
  <arg name="model_id" default=""/>
  <arg name="checkpoint" default=""/>
  <arg name="min_free_gb" default="20.0"/>
  <arg name="split_gb" default="4.0"/>
  <arg name="buffer_mb" default="1024"/>

  <node pkg="data_collection" type="bag_recorder_node.py"
        name="asmc_bag_recorder" output="screen" required="true">
    <param name="profile" value="$(arg profile)"/>
    <param name="scenario" value="$(arg scenario)"/>
    <param name="controller" value="$(arg controller)"/>
    <param name="run_id" value="$(arg run_id)"/>
    <param name="rosbag_root" value="$(arg rosbag_root)"/>
    <param name="map_slug" value="$(arg map_slug)"/>
    <param name="weather" value="$(arg weather)"/>
    <param name="sim_hour" value="$(arg sim_hour)"/>
    <param name="grpc_address" value="$(arg grpc_address)"/>
    <param name="grpc_port" value="$(arg grpc_port)"/>
    <param name="grpc_timeout_sec" value="$(arg grpc_timeout_sec)"/>
    <param name="grpc_connect_timeout_sec" value="$(arg grpc_connect_timeout_sec)"/>
    <param name="environment_poll_sec" value="$(arg environment_poll_sec)"/>
    <param name="topic_timeout_sec" value="$(arg topic_timeout_sec)"/>
    <param name="parent_raw_run_id" value="$(arg parent_raw_run_id)"/>
    <param name="model_id" value="$(arg model_id)"/>
    <param name="checkpoint" value="$(arg checkpoint)"/>
    <param name="min_free_gb" value="$(arg min_free_gb)"/>
    <param name="split_gb" value="$(arg split_gb)"/>
    <param name="buffer_mb" value="$(arg buffer_mb)"/>
  </node>
</launch>
