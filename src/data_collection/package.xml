<?xml version="1.0"?>
<package format="2">
  <name>data_collection</name>
  <version>0.1.0</version>
  <description>
    MORAI 데이터 수집 — Capture Mode GT, ROS 토픽 스냅샷, rosbag 기록·재생,
    마스크 굽기와 학습 데이터셋 manifest 생성. 산출물은 $VIP3_DATA 아래에 쌓인다.
  </description>
  <maintainer email="autonav@todo.todo">autonav</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>morai_msgs</depend>
  <depend>message_filters</depend>
  <depend>rosbag</depend>
  <depend>rosgraph</depend>
  <depend>rospkg</depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-grpcio</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
</package>
