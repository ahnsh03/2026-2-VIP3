<launch>
  <arg name="config" default="$(find drivable_bev)/config/fisheye_svm.yaml"/>
  <arg name="vehicle_config" default="$(find drivable_bev)/config/vehicles/2023_hyundai_ioniq5.yaml"/>
  <arg name="save_dir" default=""/>
  <arg name="publish_hz" default="" doc="Optional output rate override; empty keeps the YAML value"/>
  <arg name="vehicle_overlay" default="true"/>
  <arg name="vehicle_mask" default="true"/>
  <arg name="vehicle_image" default="$(find drivable_bev)/config/vehicles/ioniq5_top_view.png"/>
  <node pkg="drivable_bev" type="fisheye_svm_node.py" name="fisheye_svm_preview" output="screen">
    <rosparam command="load" file="$(arg config)" param="svm"/>
    <rosparam command="load" file="$(arg vehicle_config)" param="svm/vehicle_geometry"/>
    <param if="$(eval arg('publish_hz') != '')" name="svm/publish_hz" value="$(arg publish_hz)" type="double"/>
    <param name="save_dir" value="$(arg save_dir)"/>
    <param name="vehicle_overlay" value="$(arg vehicle_overlay)" type="bool"/>
    <param name="vehicle_mask" value="$(arg vehicle_mask)" type="bool"/>
    <param name="vehicle_image" value="$(arg vehicle_image)"/>
  </node>
</launch>
