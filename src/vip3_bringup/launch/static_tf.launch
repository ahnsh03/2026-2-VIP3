<launch>
  <!-- Active 261110 four-fisheye preset. Generated by tools/dump_static_tf.py.
       Mount frames use x forward/y left/z up; optical frames are separate. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_cam_front"
        args="3.800 0.000 0.400 0.000000 0.610865 0.000000 base_link cam_front"/>
  <!-- sensor 1 rot(roll 0.0 pitch 35.0 yaw 0.0) deg -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_cam_rear"
        args="-0.800 0.000 0.300 -3.141593 0.610865 0.000000 base_link cam_rear"/>
  <!-- sensor 2 rot(roll 0.0 pitch 35.0 yaw 180.0) deg -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_cam_left"
        args="2.100 1.050 0.700 1.570796 0.785398 0.000000 base_link cam_left"/>
  <!-- sensor 3 rot(roll 0.0 pitch 45.0 yaw 90.0) deg -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_cam_right"
        args="2.100 -1.050 0.700 -1.570796 0.785398 0.000000 base_link cam_right"/>
  <!-- sensor 4 rot(roll 0.0 pitch 45.0 yaw 270.0) deg -->

  <!-- 카메라 광학 프레임 (REP-103 body -> REP-145 optical: z 전방, x 우, y 하).
       RViz 의 Camera/Image 디스플레이와 image_geometry 가 이 규약을 쓴다.
       회전은 (yaw, pitch, roll) = (-pi/2, 0, -pi/2). -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_cam_front_optical"
        args="0 0 0 -1.570796 0.000000 -1.570796 cam_front cam_front_optical"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_cam_left_optical"
        args="0 0 0 -1.570796 0.000000 -1.570796 cam_left cam_left_optical"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_cam_right_optical"
        args="0 0 0 -1.570796 0.000000 -1.570796 cam_right cam_right_optical"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_cam_rear_optical"
        args="0 0 0 -1.570796 0.000000 -1.570796 cam_rear cam_rear_optical"/>
</launch>
