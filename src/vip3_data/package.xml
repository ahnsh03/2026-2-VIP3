<?xml version="1.0"?>
<package format="2">
  <name>vip3_data</name>
  <version>0.1.0</version>
  <description>MORAI parking bag recording, audit, replay and diagnostic snapshots.</description>
  <maintainer email="AIM2026.003@gmail.com">2026-2-VIP3</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>morai_msgs</depend>
  <depend>rosbag</depend>
  <depend>rosgraph</depend>
  <depend>rospkg</depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <test_depend>python3-nose</test_depend>
</package>
