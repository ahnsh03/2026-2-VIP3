<?xml version="1.0"?>
<package format="2">
  <name>vip3_hd_map</name>
  <version>0.1.0</version>
  <description>
    KATRI MGeo 로더와 RViz 시각화. 커스텀 메시지 없이
    visualization_msgs/MarkerArray 만 발행한다.
  </description>

  <maintainer email="AIM2026.003@gmail.com">2026-2-VIP3</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>morai_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rviz</exec_depend>

  <test_depend>python3-nose</test_depend>
</package>
