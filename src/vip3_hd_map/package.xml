<?xml version="1.0"?>
<package format="2">
  <name>vip3_hd_map</name>
  <version>0.2.0</version>
  <description>Unified AutoNav HD-map runtime, deterministic builders, and source review tools.</description>
  <maintainer email="autonav@todo.todo">INHA AutoNav</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>morai_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-shapely</exec_depend>
  <exec_depend>python3-h5py</exec_depend>
  <exec_depend>python3-pyproj</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-nose</test_depend>
</package>
