Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 5
      Class: rviz/Grid
      Color: 80; 90; 100
      Enabled: true
      Name: Metric grid
      Plane: XY
      Reference Frame: base_link
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vip3_hd_map/debug/legacy_lanes
      Name: Legacy lanes (origin only)
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /vip3_hd_map/debug/legacy_link_centers
      Name: Legacy link centers
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vip3_hd_map/debug/current_link_centers
      Name: Current link centers (not boundaries)
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vip3_hd_map/debug/competition_route
      Name: Organizer competition route
      Queue Size: 2
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vip3_hd_map/debug/ego_context
      Name: Ego footprint
      Queue Size: 2
  Enabled: true
  Global Options:
    Background Color: 15; 18; 22
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: Ego top-down
      Scale: 35
      Target Frame: base_link
      X: 12
      Y: 0
Window Geometry:
  Height: 900
  Width: 1200
